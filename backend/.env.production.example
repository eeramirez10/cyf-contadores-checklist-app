NODE_ENV=production
PORT=3002
API_NAME=cyf-backend

# Public URL of this Nest API. It is used to generate document download links.
PUBLIC_BASE_URL=https://api.example.com

# Comma-separated URLs of the deployed frontend. Do not use * in production.
CORS_ORIGINS=https://app.example.com

DATABASE_URL=postgresql://postgres.project-ref:password@aws-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.project-ref:password@aws-region.pooler.supabase.com:5432/postgres
JWT_ACCESS_SECRET=replace-with-a-random-64-byte-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-64-byte-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Required when the frontend and API are deployed on different sites.
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=none
# AUTH_COOKIE_DOMAIN=example.com
DOCUMENTS_STORAGE_DIR=/var/lib/cyf-contadores/documents
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
RESEND_API_KEY=
MAIL_FROM=
