NODE_ENV=development
PORT=3002
API_NAME=cyf-backend
CORS_ORIGINS=http://localhost:3001,https://gnomologic-zita-unarduously.ngrok-free.dev

# Supabase transaction-mode pooler URL used by the Nest application.
DATABASE_URL=postgresql://postgres.project-ref:password@aws-region.pooler.supabase.com:6543/postgres?pgbouncer=true

# Supabase session-mode pooler URL used by Prisma CLI for schema operations.
DIRECT_URL=postgresql://postgres.project-ref:password@aws-region.pooler.supabase.com:5432/postgres

JWT_ACCESS_SECRET=replace-with-a-random-64-byte-secret
JWT_REFRESH_SECRET=replace-with-a-different-random-64-byte-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
AUTH_COOKIE_SECURE=false
# Use "none" only with AUTH_COOKIE_SECURE=true when frontend and API are on different sites.
AUTH_COOKIE_SAME_SITE=lax
# AUTH_COOKIE_DOMAIN=example.com
