NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Nest API. The frontend uses this for authentication and new backend modules.
NEXT_PUBLIC_API_URL=http://localhost:3002/api/v1

# Public base URL used to build absolute file links for email and Twilio WhatsApp.
# For local demo use your ngrok HTTPS URL, e.g. https://abc123.ngrok-free.app
PUBLIC_BASE_URL=

# Local filesystem storage used by Next route handlers for uploaded PDFs.
DOCUMENTS_STORAGE_DIR=./storage/documents

# Twilio WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Email via Resend HTTP API
RESEND_API_KEY=
MAIL_FROM=demo@tu-dominio.com
